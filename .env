# Sentinel Matrix: VMware Deployment Parameters
COMPOSE_PROJECT_NAME=sentinel-matrix

# VMware Guest Host & Network
VMWARE_INTERFACE=ens33
VMWARE_GUEST_IP=127.0.0.1
SUBNET_CIDR=10.240.0.0/16

# Port Mappings
NEXUS_GRPC_PORT=50051
NEXUS_REST_PORT=9443
NEXUS_STREAM_PORT=9444

# Simulation Cadence & Performance
MATRIX_TICK_RATE_MS=100
TRAFFIC_BASE_EPS=5000
ATTACK_BURST_EPS=25000
FORGE_SAMPLE_QUOTA=2500

# Mount Directories
SHARED_VOLUME_DIR=./shared
CONFIGS_DIR=./configs
LOGS_DIR=./shared/logs
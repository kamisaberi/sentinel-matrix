# File: /home/kami/sentinel-matrix/docker/Dockerfile.apparatus_runtime

FROM python:3.11-slim

LABEL maintainer="Aryorithm Technologies B.V. <kamran@aryorithm.com>"
LABEL description="Dedicated Real-World Apparatus & Dual-Mode PCAP Runtime (Radar, FLIR, Synchrophasor)"

ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    iproute2 \
    procps \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
RUN mkdir -p /app/pcaps

COPY src/apparatus_runtime/apparatus_driver.py /app/apparatus_driver.py
RUN chmod +x /app/apparatus_driver.py

EXPOSE 8090 50050/udp

HEALTHCHECK --interval=5s --timeout=3s --retries=3 \
    CMD curl -sf http://127.0.0.1:8090/health || exit 1

ENTRYPOINT ["python3", "-u", "/app/apparatus_driver.py"]
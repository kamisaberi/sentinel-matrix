FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    procps \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Install general packages from standard PyPI
RUN pip install --no-cache-dir numpy pyyaml onnx requests

# 2. Install lightweight CPU-only PyTorch from PyTorch index
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY docker/entrypoints/forge_entrypoint.sh /entrypoint.sh
COPY src/loop/forge_watcher.py /app/forge_watcher.py

RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]